@model EmployeeManagement.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Executive Dashboard";
}

<style>
    /* Modern Dashboard Custom Styles */
    .card-modern {
        border-radius: 1rem;
        box-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card-modern:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 30px 0 rgba(34, 41, 47, 0.1);
    }
    .icon-shape {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
    }
    .text-sm { font-size: 0.85rem; }
    .table-modern > :not(caption) > * > * {
        padding: 1rem 1.25rem;
        border-bottom-color: #ebe9f1;
        align-middle;
    }
    .progress-thin { height: 6px; border-radius: 1rem; }
    .card-header-clean {
        background: transparent;
        border-bottom: none;
        padding-top: 1.5rem;
        padding-bottom: 0;
    }
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="fw-bolder mb-1 text-dark">Executive Dashboard</h2>
        <p class="text-muted text-sm mb-0">Overview of organization workforce, project velocity, and task productivity</p>
    </div>
    <div class="d-flex gap-3">
        <a asp-controller="Reports" asp-action="Index" class="btn btn-light px-3 shadow-sm rounded-pill fw-medium border">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> Reports
        </a>
        <a asp-controller="Tasks" asp-action="Create" class="btn btn-primary px-3 shadow-sm rounded-pill fw-medium">
            <i class="bi bi-plus-lg me-1"></i> New Task
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <!-- Total Employees -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card card-modern h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted text-sm fw-semibold mb-1">Employees</p>
                    <h3 class="fw-bolder mb-0">@Model.TotalEmployees</h3>
                </div>
                <div class="icon-shape bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Projects -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card card-modern h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted text-sm fw-semibold mb-1">Projects</p>
                    <h3 class="fw-bolder mb-0">@Model.ActiveProjects</h3>
                </div>
                <div class="icon-shape bg-info bg-opacity-10 text-info">
                    <i class="bi bi-folder2-open fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Tasks -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card card-modern h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted text-sm fw-semibold mb-1">Total Tasks</p>
                    <h3 class="fw-bolder mb-0">@Model.TotalTasks</h3>
                </div>
                <div class="icon-shape bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-card-checklist fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Completed Tasks -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card card-modern h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="text-muted text-sm fw-semibold mb-0">Completed</p>
                    <div class="icon-shape bg-success bg-opacity-10 text-success" style="width:36px; height:36px;">
                        <i class="bi bi-check2-all fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h3 class="fw-bolder mb-0">@Model.CompletedTasks</h3>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill fw-medium">@Model.OverallCompletionRate% rate</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Tasks -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card card-modern h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted text-sm fw-semibold mb-1">Pending</p>
                    <h3 class="fw-bolder mb-0">@Model.PendingTasks</h3>
                </div>
                <div class="icon-shape bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Overdue Tasks -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card card-modern h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-danger text-sm fw-semibold mb-1">Overdue</p>
                    <h3 class="fw-bolder mb-0 text-danger">@Model.OverdueTasks</h3>
                </div>
                <div class="icon-shape bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-exclamation-octagon fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <div class="col-lg-6 col-xl-3">
        <div class="card card-modern h-100">
            <div class="card-header card-header-clean">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart me-2 text-primary"></i>Tasks by Status</h6>
            </div>
            <div class="card-body p-4">
                <div style="height: 220px;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-xl-3">
        <div class="card card-modern h-100">
            <div class="card-header card-header-clean">
                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-steps me-2 text-info"></i>Tasks by Priority</h6>
            </div>
            <div class="card-body p-4">
                <div style="height: 220px;">
                    <canvas id="priorityChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-xl-3">
        <div class="card card-modern h-100">
            <div class="card-header card-header-clean">
                <h6 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-2 text-success"></i>Departments</h6>
            </div>
            <div class="card-body p-4">
                <div style="height: 220px;">
                    <canvas id="deptChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-xl-3">
        <div class="card card-modern h-100">
            <div class="card-header card-header-clean">
                <h6 class="fw-bold mb-0"><i class="bi bi-folder-check me-2 text-warning"></i>Project Status</h6>
            </div>
            <div class="card-body p-4">
                <div style="height: 220px;">
                    <canvas id="projChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lists: Overdue & Recent Tasks -->
<div class="row g-4">
    <!-- Overdue Tasks -->
    <div class="col-lg-6">
        <div class="card card-modern h-100 border-0" style="border-top: 4px solid #ea5455 !important;">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Action Required: Overdue
                </h6>
                <span class="badge bg-danger rounded-pill">@Model.OverdueTaskList.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.OverdueTaskList.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-modern table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase text-muted text-sm fw-semibold">
                                <tr>
                                    <th class="ps-4">Task</th>
                                    <th>Assignee</th>
                                    <th>Due Date</th>
                                    <th>Progress</th>
                                    <th class="pe-4"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in Model.OverdueTaskList)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="fw-bold text-dark text-decoration-none d-block mb-1">
                                                @task.TaskTitle
                                            </a>
                                            <span class="text-muted text-sm">@task.Project?.ProjectName</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light rounded-circle text-center me-2" style="width: 32px; height: 32px; line-height: 32px;">
                                                    <i class="bi bi-person text-secondary"></i>
                                                </div>
                                                <span class="fw-medium text-sm">@task.Assignee?.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                                                @task.DueDate.ToString("MMM dd, yyyy")
                                            </span>
                                        </td>
                                        <td style="width: 150px;">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress progress-thin flex-grow-1">
                                                    <div class="progress-bar bg-danger" style="width: @task.ProgressPercentage%"></div>
                                                </div>
                                                <span class="text-sm fw-medium">@task.ProgressPercentage%</span>
                                            </div>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-light btn-sm rounded-circle shadow-sm" style="width: 32px; height: 32px;">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <div class="icon-shape bg-success bg-opacity-10 text-success mx-auto mb-3" style="width: 64px; height: 64px;">
                            <i class="bi bi-check2-circle fs-2"></i>
                        </div>
                        <h5 class="fw-bold">All caught up!</h5>
                        <p class="mb-0">No overdue tasks found. Great work team.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Tasks -->
    <div class="col-lg-6">
        <div class="card card-modern h-100 border-0">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Recently Created
                </h6>
                <a asp-controller="Tasks" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-medium">View All <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-modern table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase text-muted text-sm fw-semibold">
                            <tr>
                                <th class="ps-4">Task</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th class="pe-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model.RecentTasks)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="fw-bold text-dark text-decoration-none d-block mb-1">
                                            @task.TaskTitle
                                        </a>
                                        <span class="text-muted text-sm">@task.Project?.ProjectName</span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 fw-medium @(task.Priority == "Critical" ? "bg-danger bg-opacity-10 text-danger" : task.Priority == "High" ? "bg-warning bg-opacity-10 text-warning" : task.Priority == "Medium" ? "bg-info bg-opacity-10 text-info" : "bg-secondary bg-opacity-10 text-secondary")">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> @task.Priority
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 fw-medium @(task.Status == "Completed" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-light text-dark border")">
                                            @task.Status
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-light btn-sm rounded-circle shadow-sm" style="width: 32px; height: 32px;">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Common modern chart styling options
        Chart.defaults.font.family = "'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif";
        Chart.defaults.color = '#6e6b7b';
        
        const noGridOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
            layout: { padding: 10 },
            cutout: '75%' // For thinner doughnut charts
        };

        const barOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false, drawBorder: false } },
                y: { grid: { borderDash: [5, 5], drawBorder: false }, beginAtZero: true, ticks: { stepSize: 1 } }
            }
        };

        // Status Doughnut
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByStatus.Keys)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByStatus.Values)),
                    backgroundColor: ['#28c76f', '#7367f0', '#ff9f43', '#82868b', '#ea5455'],
                    borderWidth: 0
                }]
            },
            options: noGridOptions
        });

        // Priority Bar
        new Chart(document.getElementById('priorityChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByPriority.Keys)),
                datasets: [{
                    label: 'Tasks',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByPriority.Values)),
                    backgroundColor: ['#b4b7bd', '#00cfe8', '#ff9f43', '#ea5455'],
                    borderRadius: 6, // Modern rounded bars
                    barThickness: 16
                }]
            },
            options: barOptions
        });

        // Department Pie (Switched to Doughnut for consistency in modern UI)
        new Chart(document.getElementById('deptChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmployeesByDepartment.Keys)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmployeesByDepartment.Values)),
                    backgroundColor: ['#7367f0', '#ea5455', '#28c76f', '#ff9f43'],
                    borderWidth: 0
                }]
            },
            options: noGridOptions
        });

        // Project Status Bar
        new Chart(document.getElementById('projChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectsByStatus.Keys)),
                datasets: [{
                    label: 'Projects',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectsByStatus.Values)),
                    backgroundColor: '#7367f0',
                    borderRadius: 6,
                    barThickness: 16
                }]
            },
            options: barOptions
        });
    </script>
}