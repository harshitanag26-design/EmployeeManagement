@model EmployeeManagement.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Workspace";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Manager Workspace</h2>
        <p class="text-muted mb-0">Hello @Model.ManagerName, here is your project status and team productivity overview.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Tasks" asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Assign Task
        </a>
        <a asp-controller="Projects" asp-action="Create" class="btn btn-outline-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-folder-plus me-1"></i> New Project
        </a>
    </div>
</div>

<!-- Quick Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-primary">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Managed Projects</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0">@Model.ManagedProjectsCount</h3>
                    <i class="bi bi-folder2-open text-primary fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-info">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Team Tasks</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0">@Model.TeamTasksCount</h3>
                    <i class="bi bi-list-task text-info fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-success">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Completed</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedTasksCount</h3>
                    <span class="badge bg-success bg-opacity-10 text-success">@Model.TeamCompletionRate% Rate</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-danger">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Overdue Attention</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0 text-danger">@Model.OverdueTasksCount</h3>
                    <i class="bi bi-clock-history text-danger fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Team Productivity Leaderboard & Managed Projects -->
<div class="row g-3 mb-4">
    <!-- Team Productivity -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-award me-1 text-warning"></i> Team Member Productivity & Completion</span>
                <span class="badge bg-light text-dark border">Rule-based Performance Index</span>
            </div>
            <div class="card-body p-0">
                @if (Model.TeamProductivity.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th>Employee</th>
                                    <th>Department</th>
                                    <th>Assigned</th>
                                    <th>Done</th>
                                    <th>Overdue</th>
                                    <th>Completion</th>
                                    <th>Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.TeamProductivity)
                                {
                                    <tr>
                                        <td class="fw-semibold">@member.EmployeeName</td>
                                        <td class="small text-muted">@member.DepartmentName</td>
                                        <td>@member.AssignedTasks</td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success">@member.CompletedTasks</span></td>
                                        <td>
                                            @if (member.OverdueTasks > 0)
                                            {
                                                <span class="badge bg-danger">@member.OverdueTasks</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">0</span>
                                            }
                                        </td>
                                        <td style="width: 120px;">
                                            <div class="d-flex align-items-center gap-1">
                                                <div class="progress progress-thin flex-grow-1">
                                                    <div class="progress-bar bg-info" style="width: @member.CompletionRate%"></div>
                                                </div>
                                                <span class="small text-muted">@member.CompletionRate%</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(member.ProductivityScore >= 80 ? "bg-success" : member.ProductivityScore >= 60 ? "bg-warning text-dark" : "bg-danger") px-2 py-1">
                                                @member.ProductivityScore
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        No team productivity data found. Assign tasks to team members to track performance.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Managed Projects -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-kanban me-1 text-primary"></i> My Managed Projects</span>
                <a asp-controller="Projects" asp-action="Index" class="btn btn-link btn-sm text-decoration-none p-0">All Projects</a>
            </div>
            <div class="card-body p-3">
                @if (Model.ManagedProjects.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var proj in Model.ManagedProjects)
                        {
                            var total = proj.Tasks.Count;
                            var completed = proj.Tasks.Count(t => t.Status == "Completed");
                            var prog = total > 0 ? Math.Round((decimal)completed / total * 100, 0) : 0;
                            <div class="border rounded-3 p-3 bg-light bg-opacity-50">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold mb-0">
                                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@proj.ProjectId" class="text-decoration-none text-dark">
                                            @proj.ProjectName
                                        </a>
                                    </h6>
                                    <span class="badge @(proj.Status == "Completed" ? "bg-success" : "bg-primary") badge-role">@proj.Status</span>
                                </div>
                                <div class="small text-muted mb-2">
                                    Due: @proj.EndDate.ToString("MMM dd, yyyy") &bull; @total Tasks (@completed Done)
                                </div>
                                <div class="progress progress-thin mb-1">
                                    <div class="progress-bar bg-primary" style="width: @prog%"></div>
                                </div>
                                <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                                    <span>Progress</span>
                                    <span>@prog%</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">No projects currently managed.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Team Tasks & Overdue -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-card-checklist me-1 text-secondary"></i> Active Team Tasks</span>
        <a asp-controller="Tasks" asp-action="Index" class="btn btn-outline-secondary btn-sm">View & Filter All Tasks</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>Task</th>
                        <th>Project</th>
                        <th>Assignee</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Progress</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.TeamTasks)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="text-decoration-none text-dark">
                                    @task.TaskTitle
                                </a>
                            </td>
                            <td class="small text-muted">@task.Project?.ProjectName</td>
                            <td class="small fw-medium">@task.Assignee?.Name</td>
                            <td>
                                <span class="badge @(task.Priority == "Critical" ? "bg-danger" : task.Priority == "High" ? "bg-warning text-dark" : "bg-secondary")">
                                    @task.Priority
                                </span>
                            </td>
                            <td>
                                <span class="badge @(task.Status == "Completed" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                                    @task.Status
                                </span>
                            </td>
                            <td>
                                <span class="small @(task.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                    @task.DueDate.ToString("MMM dd, yyyy")
                                    @if (task.IsOverdue)
                                    {
                                        <i class="bi bi-exclamation-circle-fill text-danger ms-1"></i>
                                    }
                                </span>
                            </td>
                            <td style="width: 110px;">
                                <div class="progress progress-thin">
                                    <div class="progress-bar @(task.Status == "Completed" ? "bg-success" : "bg-primary")" style="width: @task.ProgressPercentage%"></div>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-outline-secondary btn-sm py-0 px-2">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
