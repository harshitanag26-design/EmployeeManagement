@model EmployeeManagement.ViewModels.EmployeeDetailsViewModel
@{
    ViewData["Title"] = $"{Model.User.Name} - Profile & Productivity";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 50px; height: 50px;">
            @Model.User.Name.Substring(0, 1).ToUpper()
        </div>
        <div>
            <h2 class="fw-bold mb-0">@Model.User.Name</h2>
            <div class="text-muted small">
                @Model.User.Email &bull;
                <span class="badge bg-light text-dark border">@(Model.User.Department?.DepartmentName ?? "General")</span> &bull;
                <span class="badge @(Model.User.RoleId == 1 ? "bg-danger" : Model.User.RoleId == 2 ? "bg-primary" : "bg-info text-dark")">@(Model.User.Role?.RoleName)</span>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.User.UserId" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<!-- Productivity Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-primary">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Assigned Tasks</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0">@Model.TotalAssignedTasks</h3>
                    <i class="bi bi-card-checklist text-primary fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-success">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Completion Rate</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletionRate%</h3>
                    <span class="badge bg-success bg-opacity-10 text-success">@Model.CompletedTasks Done</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-warning">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Productivity Score</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0 @(Model.ProductivityScore >= 80 ? "text-success" : Model.ProductivityScore >= 60 ? "text-warning" : "text-danger")">
                        @Model.ProductivityScore / 100
                    </h3>
                    <i class="bi bi-speedometer2 fs-3 text-warning"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-danger">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Overdue Tasks</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0 text-danger">@Model.OverdueTasks</h3>
                    <i class="bi bi-exclamation-triangle text-danger fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Task History -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-task me-1 text-primary"></i> Assigned Task History</span>
        <span class="small text-muted">Est. Hours: @Model.TotalEstimatedHours hrs &bull; Act. Hours: @Model.TotalActualHours hrs</span>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentTasks.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th>Task</th>
                            <th>Project</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.RecentTasks)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="fw-semibold text-decoration-none text-dark">
                                        @task.TaskTitle
                                    </a>
                                </td>
                                <td class="small text-muted">@task.Project?.ProjectName</td>
                                <td>
                                    <span class="badge @(task.Priority == "Critical" ? "bg-danger" : task.Priority == "High" ? "bg-warning text-dark" : "bg-secondary")">
                                        @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(task.Status == "Completed" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                                        @task.Status
                                    </span>
                                </td>
                                <td class="small @(task.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                    @task.DueDate.ToString("MMM dd, yyyy")
                                </td>
                                <td style="width: 120px;">
                                    <div class="d-flex align-items-center gap-1">
                                        <div class="progress progress-thin flex-grow-1">
                                            <div class="progress-bar @(task.Status == "Completed" ? "bg-success" : "bg-primary")" style="width: @task.ProgressPercentage%"></div>
                                        </div>
                                        <span class="small text-muted">@task.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-outline-secondary btn-sm py-0 px-2">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">No tasks assigned yet.</div>
        }
    </div>
</div>
