@model IEnumerable<EmployeeManagement.Models.User>
@{
    ViewData["Title"] = "Employee Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Employee Directory</h2>
        <p class="text-muted mb-0">Manage employee accounts, department assignments, and system access</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add Employee
    </a>
</div>

<!-- Filter Bar -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="departmentId" asp-items="ViewBag.Departments" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Employees Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>ID</th>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="text-muted small">#@emp.UserId</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-light text-primary border rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                                        @emp.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@emp.UserId" class="fw-semibold text-decoration-none text-dark">
                                            @emp.Name
                                        </a>
                                        <div class="text-muted small">@emp.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(emp.Department?.DepartmentName ?? "Unassigned")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(emp.RoleId == 1 ? "bg-danger" : emp.RoleId == 2 ? "bg-primary" : "bg-info text-dark") badge-role">
                                    @(emp.Role?.RoleName ?? "Employee")
                                </span>
                            </td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle me-1"></i> Deactivated</span>
                                }
                            </td>
                            <td class="small text-muted">@emp.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@emp.UserId" class="btn btn-outline-secondary" title="View Profile & Productivity">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@emp.UserId" class="btn btn-outline-primary" title="Edit Employee">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@emp.UserId" method="post" class="d-inline" onsubmit="return confirm('Change active status for this user?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(emp.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(emp.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(emp.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
