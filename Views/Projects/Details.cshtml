@model EmployeeManagement.ViewModels.ProjectDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Project.ProjectName} - Project Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.Project.ProjectName</h2>
            <span class="badge @(Model.Project.Status == "Completed" ? "bg-success" : Model.Project.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                @Model.Project.Status
            </span>
        </div>
        <p class="text-muted mb-0">@(Model.Project.Description ?? "No description provided.")</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Project.ProjectId" class="btn btn-primary btn-sm px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Task
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Project.ProjectId" class="btn btn-outline-primary btn-sm px-3">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<!-- Project Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-primary">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Manager</span>
                <h5 class="fw-bold mb-0 mt-2">@(Model.Project.Manager?.Name ?? "Unassigned")</h5>
                <span class="small text-muted">Lead Supervisor</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-info">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Timeline</span>
                <h6 class="fw-bold mb-0 mt-2">@Model.Project.StartDate.ToString("MMM dd") - @Model.Project.EndDate.ToString("MMM dd, yyyy")</h6>
                <span class="small text-muted">Schedule Span</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-success">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Completion Velocity</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h4 class="fw-bold mb-0 text-success">@Model.ProgressPercentage%</h4>
                    <span class="small text-muted">@Model.CompletedTasks / @Model.TotalTasks Done</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card border-start border-4 border-danger">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Overdue Risks</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h4 class="fw-bold mb-0 text-danger">@Model.OverdueTasks</h4>
                    <i class="bi bi-clock-history text-danger fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Project Progress Bar -->
<div class="card mb-4">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between small text-muted mb-1">
            <span class="fw-semibold">Cumulative Progress (@Model.CompletedTasks completed of @Model.TotalTasks total tasks)</span>
            <span class="fw-bold">@Model.ProgressPercentage%</span>
        </div>
        <div class="progress" style="height: 12px; border-radius: 6px;">
            <div class="progress-bar @(Model.Project.Status == "Completed" ? "bg-success" : "bg-primary") progress-bar-striped progress-bar-animated" style="width: @Model.ProgressPercentage%"></div>
        </div>
    </div>
</div>

<!-- Tasks under Project -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-check me-1 text-primary"></i> Tasks in this Project (@Model.TotalTasks)</span>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Project.ProjectId" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus me-1"></i> Add Task
            </a>
        }
    </div>
    <div class="card-body p-0">
        @if (Model.Tasks.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th>Task</th>
                            <th>Assignee</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Hours (Est / Act)</th>
                            <th>Progress</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="text-decoration-none text-dark">
                                        @task.TaskTitle
                                    </a>
                                </td>
                                <td class="small fw-medium">@(task.Assignee?.Name ?? "Unassigned")</td>
                                <td>
                                    <span class="badge @(task.Priority == "Critical" ? "bg-danger" : task.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(task.Status == "Completed" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                                        @task.Status
                                    </span>
                                </td>
                                <td class="small @(task.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                    @task.DueDate.ToString("MMM dd, yyyy")
                                    @if (task.IsOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </td>
                                <td class="small text-muted">@task.EstimatedHours h / @task.ActualHours h</td>
                                <td style="width: 120px;">
                                    <div class="d-flex align-items-center gap-1">
                                        <div class="progress progress-thin flex-grow-1">
                                            <div class="progress-bar @(task.Status == "Completed" ? "bg-success" : "bg-primary")" style="width: @task.ProgressPercentage%"></div>
                                        </div>
                                        <span class="small text-muted">@task.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-outline-secondary btn-sm py-0 px-2">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-clipboard-check fs-2 text-muted d-block mb-2"></i>
                No tasks have been added to this project yet.
            </div>
        }
    </div>
</div>
