@model EmployeeManagement.ViewModels.GlobalReportsViewModel
@{
    ViewData["Title"] = "Productivity Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Productivity Reports & Analytics</h2>
        <p class="text-muted mb-0">Consolidated employee velocity, project health, and monthly performance indexes</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
            <i class="bi bi-printer me-1"></i> Print / Export PDF
        </button>
    </div>
</div>

<!-- Monthly Summary Card (Section 21.3) -->
<div class="card mb-4 border-primary border-opacity-25 bg-light bg-opacity-25">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-calendar3 me-1"></i> Monthly Throughput Summary: @Model.MonthlyReport.MonthName
            </h5>
            <span class="badge bg-primary px-3 py-2 fs-6">@Model.MonthlyReport.CompletionRate% Monthly Velocity</span>
        </div>

        <div class="row g-3 text-center">
            <div class="col-md-3">
                <div class="p-3 bg-white border rounded-3 shadow-sm">
                    <span class="text-muted small text-uppercase fw-semibold">Tasks Created</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@Model.MonthlyReport.TasksCreated</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white border rounded-3 shadow-sm">
                    <span class="text-muted small text-uppercase fw-semibold">Tasks Completed</span>
                    <h3 class="fw-bold mb-0 text-success mt-1">@Model.MonthlyReport.TasksCompleted</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white border rounded-3 shadow-sm">
                    <span class="text-muted small text-uppercase fw-semibold">Tasks Pending</span>
                    <h3 class="fw-bold mb-0 text-warning mt-1">@Model.MonthlyReport.TasksPending</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white border rounded-3 shadow-sm">
                    <span class="text-muted small text-uppercase fw-semibold">Tasks Overdue</span>
                    <h3 class="fw-bold mb-0 text-danger mt-1">@Model.MonthlyReport.TasksOverdue</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs for Employee & Project Reports -->
<ul class="nav nav-tabs mb-3" id="reportTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="employee-tab" data-bs-toggle="tab" data-bs-target="#employeeReport" type="button" role="tab">
            <i class="bi bi-person-lines-fill me-1"></i> Employee Productivity Report
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="project-tab" data-bs-toggle="tab" data-bs-target="#projectReport" type="button" role="tab">
            <i class="bi bi-folder2-open me-1"></i> Project Progress Report
        </button>
    </li>
</ul>

<div class="tab-content" id="reportTabsContent">
    <!-- Employee Report Tab (Section 21.1) -->
    <div class="tab-pane fade show active" id="employeeReport" role="tabpanel">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Employee Task & Productivity Metrics</span>
                <span class="small text-muted">Ranked by Productivity Score</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th>Employee</th>
                                <th>Department</th>
                                <th>Assigned</th>
                                <th>Completed</th>
                                <th>Pending</th>
                                <th>Overdue</th>
                                <th>Completion %</th>
                                <th>Est / Act Hours</th>
                                <th>Productivity Index</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.EmployeeReports)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.EmployeeId" class="fw-semibold text-decoration-none text-dark">
                                            @emp.EmployeeName
                                        </a>
                                    </td>
                                    <td class="small text-muted">@emp.DepartmentName</td>
                                    <td>@emp.AssignedTasks</td>
                                    <td><span class="badge bg-success bg-opacity-10 text-success">@emp.CompletedTasks</span></td>
                                    <td>@emp.PendingTasks</td>
                                    <td>
                                        @if (emp.OverdueTasks > 0)
                                        {
                                            <span class="badge bg-danger">@emp.OverdueTasks</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">0</span>
                                        }
                                    </td>
                                    <td style="width: 140px;">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="progress progress-thin flex-grow-1">
                                                <div class="progress-bar bg-info" style="width: @emp.CompletionRate%"></div>
                                            </div>
                                            <span class="small text-muted">@emp.CompletionRate%</span>
                                        </div>
                                    </td>
                                    <td class="small text-muted">@emp.TotalEstimatedHours h / @emp.TotalActualHours h</td>
                                    <td>
                                        <span class="badge @(emp.ProductivityScore >= 80 ? "bg-success" : emp.ProductivityScore >= 60 ? "bg-warning text-dark" : "bg-danger") px-3 py-1">
                                            @emp.ProductivityScore / 100
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Project Report Tab (Section 21.2) -->
    <div class="tab-pane fade" id="projectReport" role="tabpanel">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Project Velocity & Milestone Completion</span>
                <span class="small text-muted">Ranked by Project Progress</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th>Project</th>
                                <th>Manager</th>
                                <th>Status</th>
                                <th>Schedule</th>
                                <th>Total Tasks</th>
                                <th>Completed</th>
                                <th>Pending</th>
                                <th>Overdue</th>
                                <th>Overall Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proj in Model.ProjectReports)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@proj.ProjectId" class="fw-semibold text-decoration-none text-dark">
                                            @proj.ProjectName
                                        </a>
                                    </td>
                                    <td class="small fw-medium">@proj.ManagerName</td>
                                    <td>
                                        <span class="badge @(proj.Status == "Completed" ? "bg-success" : proj.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                                            @proj.Status
                                        </span>
                                    </td>
                                    <td class="small text-muted">@proj.StartDate.ToString("MMM dd") - @proj.EndDate.ToString("MMM dd, yyyy")</td>
                                    <td>@proj.TotalTasks</td>
                                    <td><span class="badge bg-success bg-opacity-10 text-success">@proj.CompletedTasks</span></td>
                                    <td>@proj.PendingTasks</td>
                                    <td>
                                        @if (proj.OverdueTasks > 0)
                                        {
                                            <span class="badge bg-danger">@proj.OverdueTasks</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">0</span>
                                        }
                                    </td>
                                    <td style="width: 150px;">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="progress progress-thin flex-grow-1">
                                                <div class="progress-bar @(proj.Status == "Completed" ? "bg-success" : "bg-primary")" style="width: @proj.ProgressPercentage%"></div>
                                            </div>
                                            <span class="small fw-bold">@proj.ProgressPercentage%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
