@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-6 text-center">
        <div class="card p-5 border-0 shadow-sm">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-danger">Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have the required role permissions to view or perform operations on this page.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 rounded-pill">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
