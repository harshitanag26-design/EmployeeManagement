@model EmployeeManagement.ViewModels.TaskFilterViewModel
@{
    ViewData["Title"] = "Task Directory & Filter";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Task Management & Filter</h2>
        <p class="text-muted mb-0">Search, filter, and track tasks across projects, employees, and deadlines</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Create Task
        </a>
    }
</div>

<!-- Search & Filter Panel (Section 20) -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <span class="small fw-bold text-secondary text-uppercase"><i class="bi bi-funnel me-1"></i> Multi-Parameter Filter Engine</span>
    </div>
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-lg-3 col-md-6">
                <label class="form-label small text-muted mb-1">Search Keywords</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Title or description..." />
                </div>
            </div>

            <div class="col-lg-2 col-md-3 col-sm-6">
                <label class="form-label small text-muted mb-1">Status</label>
                <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select form-select-sm"></select>
            </div>

            <div class="col-lg-2 col-md-3 col-sm-6">
                <label class="form-label small text-muted mb-1">Priority</label>
                <select asp-for="Priority" asp-items="Model.PriorityOptions" class="form-select form-select-sm"></select>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">Assigned Employee</label>
                <select asp-for="AssignedTo" asp-items="Model.EmployeeOptions" class="form-select form-select-sm">
                    <option value="">All Employees</option>
                </select>
            </div>

            <div class="col-lg-3 col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">Project</label>
                <select asp-for="ProjectId" asp-items="Model.ProjectOptions" class="form-select form-select-sm">
                    <option value="">All Projects</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">From Due Date</label>
                <input type="date" asp-for="FromDate" class="form-control form-control-sm" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">To Due Date</label>
                <input type="date" asp-for="ToDate" class="form-control form-control-sm" />
            </div>

            <div class="col-lg-8 col-md-12 d-flex align-items-end justify-content-end gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-search me-1"></i> Apply Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Task Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="small fw-semibold text-muted">Found @Model.Tasks.Count Tasks matching criteria</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Tasks.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th>Task Title</th>
                            <th>Project</th>
                            <th>Assignee</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@task.TaskId" class="fw-semibold text-decoration-none text-dark">
                                        @task.TaskTitle
                                    </a>
                                </td>
                                <td class="small text-muted">@task.Project?.ProjectName</td>
                                <td class="small fw-medium">@task.Assignee?.Name</td>
                                <td>
                                    <span class="badge @(task.Priority == "Critical" ? "bg-danger" : task.Priority == "High" ? "bg-warning text-dark" : task.Priority == "Medium" ? "bg-info text-dark" : "bg-secondary")">
                                        @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(task.Status == "Completed" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                                        @task.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="small @(task.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                        @task.DueDate.ToString("MMM dd, yyyy")
                                        @if (task.IsOverdue)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Overdue"></i>
                                        }
                                    </span>
                                </td>
                                <td style="width: 130px;">
                                    <div class="d-flex align-items-center gap-1">
                                        <div class="progress progress-thin flex-grow-1">
                                            <div class="progress-bar @(task.Status == "Completed" ? "bg-success" : task.IsOverdue ? "bg-danger" : "bg-primary")" style="width: @task.ProgressPercentage%"></div>
                                        </div>
                                        <span class="small text-muted">@task.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@task.TaskId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@task.TaskId" method="post" class="d-inline" onsubmit="return confirm('Delete this task?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-search fs-2 text-muted d-block mb-2"></i>
                No tasks match your selected search and filter criteria.
            </div>
        }
    </div>
</div>
