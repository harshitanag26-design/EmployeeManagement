@model EmployeeManagement.ViewModels.TaskFormViewModel
@{
    ViewData["Title"] = "Edit Task";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">Edit Task</h3>
                <p class="text-muted small">Update specifications, reassign, or alter status</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.TaskId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Task
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TaskId" />
                    <input type="hidden" asp-for="CreatedBy" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ProjectId" class="form-label small fw-semibold">Associated Project</label>
                            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select" required></select>
                            <span asp-validation-for="ProjectId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold">Assigned Employee</label>
                            <select asp-for="AssignedTo" asp-items="Model.Employees" class="form-select" required></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TaskTitle" class="form-label small fw-semibold">Task Title</label>
                        <input asp-for="TaskTitle" class="form-control" required />
                        <span asp-validation-for="TaskTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                            <select asp-for="Priority" class="form-select" required>
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="Pending">Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="On Hold">On Hold</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ProgressPercentage" class="form-label small fw-semibold">Progress (%)</label>
                            <input asp-for="ProgressPercentage" class="form-control" type="number" min="0" max="100" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EstimatedHours" class="form-label small fw-semibold">Est. Hours</label>
                            <input asp-for="EstimatedHours" class="form-control" type="number" step="0.5" min="0" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label small fw-semibold">Start Date</label>
                            <input asp-for="StartDate" class="form-control" type="date" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label small fw-semibold">Due Date</label>
                            <input asp-for="DueDate" class="form-control" type="date" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ActualHours" class="form-label small fw-semibold">Actual Hours</label>
                            <input asp-for="ActualHours" class="form-control" type="number" step="0.5" min="0" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-light btn-sm px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
