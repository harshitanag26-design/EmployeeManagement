@model IEnumerable<EmployeeManagement.Models.TaskItem>
@{
    ViewData["Title"] = "My Task Board";
    var pendingList = Model.Where(t => t.Status == "Pending").ToList();
    var inProgressList = Model.Where(t => t.Status == "In Progress").ToList();
    var completedList = Model.Where(t => t.Status == "Completed").ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1">My Task Board</h2>
        <p class="text-muted mb-0">Drag and drop tasks between columns to update their workflow status in real time</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (User.IsInRole("Employee"))
        {
            <span class="badge bg-warning bg-opacity-10 text-dark border px-3 py-2">
                <i class="bi bi-shield-lock me-1 text-dark"></i> Forward-only Lifecycle (Pending &rarr; In Progress &rarr; Completed)
            </span>
        }
        <span class="badge bg-light text-secondary border px-3 py-2">
            <i class="bi bi-arrows-move me-1 text-primary"></i> Drag & Drop Enabled
        </span>
    </div>
</div>

<style>
    .task-card {
        cursor: grab;
        transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
        user-select: none;
    }
    .task-card:active {
        cursor: grabbing;
    }
    .task-card.dragging {
        opacity: 0.45;
        transform: scale(0.98);
        border: 2px dashed #2563eb !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .kanban-dropzone {
        min-height: 320px;
        border-radius: 0.5rem;
        transition: all 0.2s ease-in-out;
        border: 2px dashed transparent;
    }
    .kanban-dropzone.drag-over {
        background-color: #eff6ff !important;
        border-color: #2563eb !important;
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
    }
    .drag-handle {
        cursor: grab;
        opacity: 0.5;
        transition: opacity 0.15s ease;
    }
    .task-card:hover .drag-handle {
        opacity: 1;
    }
    .toast-container {
        z-index: 1080;
    }
</style>

<!-- 3-Column Kanban Board with Drag & Drop -->
<div class="row g-3">
    <!-- PENDING COLUMN -->
    <div class="col-lg-4">
        <div class="card h-100 bg-light border-0 shadow-none">
            <div class="card-header bg-white border d-flex justify-content-between align-items-center rounded-3 mb-2">
                <span class="fw-bold text-secondary">
                    <i class="bi bi-circle me-1"></i> Pending
                </span>
                <span id="badge-Pending" class="badge bg-secondary">@pendingList.Count</span>
            </div>
            <div id="column-Pending"
                 class="kanban-dropzone d-flex flex-column gap-2 p-1"
                 data-status="Pending"
                 ondragover="handleDragOver(event)"
                 ondragleave="handleDragLeave(event)"
                 ondrop="handleDrop(event, 'Pending')">

                @foreach (var task in pendingList)
                {
                    <div class="card border stat-card shadow-sm task-card"
                         id="task-card-@task.TaskId"
                         draggable="true"
                         data-task-id="@task.TaskId"
                         data-current-status="Pending"
                         data-title="@task.TaskTitle"
                         data-project="@task.Project?.ProjectName"
                         data-priority="@task.Priority"
                         data-due="@task.DueDate.ToString("MMM dd")"
                         data-is-overdue="@task.IsOverdue.ToString().ToLower()"
                         data-progress="@task.ProgressPercentage"
                         data-hours="@task.ActualHours"
                         data-est-hours="@task.EstimatedHours"
                         ondragstart="handleDragStart(event)"
                         ondragend="handleDragEnd(event)">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-grip-vertical drag-handle text-muted" title="Drag to move"></i>
                                    <span class="badge badge-priority @(task.Priority == "Critical" ? "bg-danger" : task.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")" style="font-size: 0.7rem;">
                                        @task.Priority
                                    </span>
                                </div>
                                <span class="small task-due-label @(task.IsOverdue ? "text-danger fw-bold" : "text-muted")" style="font-size: 0.75rem;">
                                    Due @task.DueDate.ToString("MMM dd")
                                </span>
                            </div>
                            <h6 class="fw-bold mb-1 task-title-text">
                                <a asp-action="Details" asp-route-id="@task.TaskId" class="text-decoration-none text-dark">
                                    @task.TaskTitle
                                </a>
                            </h6>
                            <div class="text-muted small mb-2">@task.Project?.ProjectName</div>

                            <div class="task-action-row d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="small text-muted task-hours-label">@task.EstimatedHours hrs est.</span>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                        onclick="openQuickUpdateModal(@task.TaskId, '@task.TaskTitle.Replace("'", "\\'")', 'Pending', @task.ProgressPercentage, @task.ActualHours)">
                                    <i class="bi bi-play-fill me-1"></i> Start Task
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <div class="empty-state text-center text-muted py-5 small @(pendingList.Any() ? "d-none" : "")">
                    <i class="bi bi-inbox fs-3 text-muted d-block mb-1"></i>
                    No pending tasks.
                </div>
            </div>
        </div>
    </div>

    <!-- IN PROGRESS COLUMN -->
    <div class="col-lg-4">
        <div class="card h-100 bg-light border-0 shadow-none">
            <div class="card-header bg-white border d-flex justify-content-between align-items-center rounded-3 mb-2">
                <span class="fw-bold text-primary">
                    <i class="bi bi-hourglass-split me-1"></i> In Progress
                </span>
                <span id="badge-In-Progress" class="badge bg-primary">@inProgressList.Count</span>
            </div>
            <div id="column-In-Progress"
                 class="kanban-dropzone d-flex flex-column gap-2 p-1"
                 data-status="In Progress"
                 ondragover="handleDragOver(event)"
                 ondragleave="handleDragLeave(event)"
                 ondrop="handleDrop(event, 'In Progress')">

                @foreach (var task in inProgressList)
                {
                    <div class="card border stat-card shadow-sm border-start border-3 border-primary task-card"
                         id="task-card-@task.TaskId"
                         draggable="true"
                         data-task-id="@task.TaskId"
                         data-current-status="In Progress"
                         data-title="@task.TaskTitle"
                         data-project="@task.Project?.ProjectName"
                         data-priority="@task.Priority"
                         data-due="@task.DueDate.ToString("MMM dd")"
                         data-is-overdue="@task.IsOverdue.ToString().ToLower()"
                         data-progress="@task.ProgressPercentage"
                         data-hours="@task.ActualHours"
                         data-est-hours="@task.EstimatedHours"
                         ondragstart="handleDragStart(event)"
                         ondragend="handleDragEnd(event)">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-grip-vertical drag-handle text-muted" title="Drag to move"></i>
                                    <span class="badge badge-priority @(task.Priority == "Critical" ? "bg-danger" : task.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")" style="font-size: 0.7rem;">
                                        @task.Priority
                                    </span>
                                </div>
                                <span class="small task-due-label @(task.IsOverdue ? "text-danger fw-bold" : "text-muted")" style="font-size: 0.75rem;">
                                    Due @task.DueDate.ToString("MMM dd")
                                    @if (task.IsOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </span>
                            </div>
                            <h6 class="fw-bold mb-1 task-title-text">
                                <a asp-action="Details" asp-route-id="@task.TaskId" class="text-decoration-none text-dark">
                                    @task.TaskTitle
                                </a>
                            </h6>
                            <div class="text-muted small mb-2">@task.Project?.ProjectName</div>

                            <div class="task-progress-box mb-2">
                                <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 0.72rem;">
                                    <span>Progress</span>
                                    <strong class="progress-percent-label">@task.ProgressPercentage%</strong>
                                </div>
                                <div class="progress progress-thin">
                                    <div class="progress-bar @(task.IsOverdue ? "bg-danger" : "bg-primary")" style="width: @task.ProgressPercentage%"></div>
                                </div>
                            </div>

                            <div class="task-action-row d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="small text-muted task-hours-label">@task.ActualHours / @task.EstimatedHours hrs</span>
                                <button type="button" class="btn btn-sm btn-primary py-0 px-2"
                                        onclick="openQuickUpdateModal(@task.TaskId, '@task.TaskTitle.Replace("'", "\\'")', 'In Progress', @task.ProgressPercentage, @task.ActualHours)">
                                    <i class="bi bi-pencil-square me-1"></i> Update
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <div class="empty-state text-center text-muted py-5 small @(inProgressList.Any() ? "d-none" : "")">
                    <i class="bi bi-inbox fs-3 text-muted d-block mb-1"></i>
                    No tasks in progress.
                </div>
            </div>
        </div>
    </div>

    <!-- COMPLETED COLUMN -->
    <div class="col-lg-4">
        <div class="card h-100 bg-light border-0 shadow-none">
            <div class="card-header bg-white border d-flex justify-content-between align-items-center rounded-3 mb-2">
                <span class="fw-bold text-success">
                    <i class="bi bi-check2-circle me-1"></i> Completed
                </span>
                <span id="badge-Completed" class="badge bg-success">@completedList.Count</span>
            </div>
            <div id="column-Completed"
                 class="kanban-dropzone d-flex flex-column gap-2 p-1"
                 data-status="Completed"
                 ondragover="handleDragOver(event)"
                 ondragleave="handleDragLeave(event)"
                 ondrop="handleDrop(event, 'Completed')">

                @foreach (var task in completedList)
                {
                    <div class="card border stat-card shadow-sm border-start border-3 border-success opacity-75 task-card"
                         id="task-card-@task.TaskId"
                         draggable="true"
                         data-task-id="@task.TaskId"
                         data-current-status="Completed"
                         data-title="@task.TaskTitle"
                         data-project="@task.Project?.ProjectName"
                         data-priority="@task.Priority"
                         data-due="@(task.CompletedDate?.ToString("MMM dd") ?? task.UpdatedAt.ToString("MMM dd"))"
                         data-is-overdue="false"
                         data-progress="100"
                         data-hours="@task.ActualHours"
                         data-est-hours="@task.EstimatedHours"
                         ondragstart="handleDragStart(event)"
                         ondragend="handleDragEnd(event)">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-grip-vertical drag-handle text-muted" title="Drag to move"></i>
                                    <span class="badge bg-success" style="font-size: 0.7rem;">Completed</span>
                                </div>
                                <span class="small text-muted task-due-label" style="font-size: 0.75rem;">
                                    @(task.CompletedDate?.ToString("MMM dd") ?? task.UpdatedAt.ToString("MMM dd"))
                                </span>
                            </div>
                            <h6 class="fw-bold mb-1 text-decoration-line-through text-muted task-title-text">
                                <a asp-action="Details" asp-route-id="@task.TaskId" class="text-decoration-none text-muted">
                                    @task.TaskTitle
                                </a>
                            </h6>
                            <div class="text-muted small mb-2">@task.Project?.ProjectName</div>

                            <div class="task-action-row d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="small text-success"><i class="bi bi-check-all me-1"></i> 100% Done</span>
                                <a asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-sm btn-outline-secondary py-0 px-2">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <div class="empty-state text-center text-muted py-5 small @(completedList.Any() ? "d-none" : "")">
                    <i class="bi bi-inbox fs-3 text-muted d-block mb-1"></i>
                    No completed tasks yet.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container for Drag-and-Drop Feedback -->
<div class="position-fixed bottom-0 end-0 p-3 toast-container">
    <div id="dragToast" class="toast align-items-center border-0 shadow-lg text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i id="dragToastIcon" class="bi fs-5"></i>
                <span id="dragToastMsg">Task status updated.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Quick Update Progress Modal -->
<div class="modal fade" id="quickUpdateModal" tabindex="-1" aria-labelledby="quickUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateProgress" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TaskId" id="modalTaskId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="quickUpdateModalLabel">Update Task Progress</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Task</label>
                        <input type="text" id="modalTaskTitle" class="form-control" readonly />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Status</label>
                            <select name="Status" id="modalStatus" class="form-select" onchange="onStatusChange(this.value)">
                                <option value="Pending">Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="On Hold">On Hold</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Progress Percentage (%)</label>
                            <input type="number" name="ProgressPercentage" id="modalProgress" class="form-control" min="0" max="100" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Actual Hours Spent</label>
                        <input type="number" step="0.5" name="ActualHours" id="modalActualHours" class="form-control" min="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Optional Note / Comment</label>
                        <textarea name="Comment" class="form-control" rows="2" placeholder="Describe work done..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3">Save Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isEmployee = @(User.IsInRole("Employee") ? "true" : "false");
        const stepOrder = { 'Pending': 1, 'In Progress': 2, 'Completed': 3 };
        let draggedTaskId = null;
        let sourceColumnStatus = null;

        function handleDragStart(e) {
            const card = e.currentTarget;
            draggedTaskId = card.getAttribute('data-task-id');
            sourceColumnStatus = card.getAttribute('data-current-status');
            card.classList.add('dragging');

            e.dataTransfer.setData('text/plain', draggedTaskId);
            e.dataTransfer.effectAllowed = 'move';
        }

        function handleDragEnd(e) {
            e.currentTarget.classList.remove('dragging');
            document.querySelectorAll('.kanban-dropzone').forEach(col => {
                col.classList.remove('drag-over');
            });
        }

        function handleDragOver(e) {
            e.preventDefault();
            const dropzone = e.currentTarget;
            const targetStatus = dropzone.getAttribute('data-status');

            // If employee, reject backward transitions at cursor level
            if (isEmployee && sourceColumnStatus) {
                const sourceStep = stepOrder[sourceColumnStatus] || 0;
                const targetStep = stepOrder[targetStatus] || 0;
                if (targetStep < sourceStep) {
                    e.dataTransfer.dropEffect = 'none';
                    return;
                }
            }

            e.dataTransfer.dropEffect = 'move';
            if (!dropzone.classList.contains('drag-over')) {
                dropzone.classList.add('drag-over');
            }
        }

        function handleDragLeave(e) {
            const dropzone = e.currentTarget;
            if (e.relatedTarget && !dropzone.contains(e.relatedTarget)) {
                dropzone.classList.remove('drag-over');
            }
        }

        async function handleDrop(e, targetStatus) {
            e.preventDefault();
            const dropzone = e.currentTarget;
            dropzone.classList.remove('drag-over');

            const taskId = e.dataTransfer.getData('text/plain') || draggedTaskId;
            if (!taskId) return;

            const card = document.getElementById('task-card-' + taskId);
            if (!card) return;

            const originalStatus = card.getAttribute('data-current-status');
            if (originalStatus === targetStatus) return; // Dropped in same column

            const sourceStep = stepOrder[originalStatus] || 0;
            const targetStep = stepOrder[targetStatus] || 0;

            // Client-side validation: Employees cannot move tasks backwards
            if (isEmployee && targetStep < sourceStep) {
                showToast("Action Restricted: Employees cannot move tasks backward after forwarding to another state.", false);
                return;
            }

            // Target column container
            const columnId = 'column-' + targetStatus.replace(/\s+/g, '-');
            const targetContainer = document.getElementById(columnId);
            if (!targetContainer) return;

            const sourceColumnId = 'column-' + originalStatus.replace(/\s+/g, '-');
            const sourceContainer = document.getElementById(sourceColumnId);

            // Optimistically move card in DOM
            targetContainer.insertBefore(card, targetContainer.querySelector('.empty-state'));
            updateColumnCounters();

            // Send AJAX request to server
            try {
                const response = await fetch('/Tasks/MoveStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        TaskId: parseInt(taskId),
                        NewStatus: targetStatus
                    })
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'Operation rejected by server');
                }

                // Update card's data attributes & UI for new status
                card.setAttribute('data-current-status', targetStatus);
                card.setAttribute('data-progress', data.progress);
                applyCardStylesForStatus(card, targetStatus, data);
                showToast(`Task moved to "${targetStatus}"`, true);
            } catch (err) {
                console.error('Drag & drop move error:', err);
                // Revert move back to source column
                if (sourceContainer) {
                    sourceContainer.insertBefore(card, sourceContainer.querySelector('.empty-state'));
                    card.setAttribute('data-current-status', originalStatus);
                    updateColumnCounters();
                }
                showToast(err.message || 'Failed to update task. Please try again.', false);
            }
        }

        function applyCardStylesForStatus(card, status, data) {
            const taskId = card.getAttribute('data-task-id');
            const title = card.getAttribute('data-title') || '';
            const priority = card.getAttribute('data-priority') || 'Medium';
            const hours = card.getAttribute('data-hours') || '0';
            const estHours = card.getAttribute('data-est-hours') || '0';
            const titleLink = card.querySelector('.task-title-text a');
            const titleContainer = card.querySelector('.task-title-text');
            const actionRow = card.querySelector('.task-action-row');

            // Reset borders
            card.classList.remove('border-primary', 'border-success', 'border-start', 'border-3', 'opacity-75');

            if (status === 'Completed') {
                card.classList.add('border-start', 'border-3', 'border-success', 'opacity-75');
                titleContainer.classList.add('text-decoration-line-through', 'text-muted');
                titleLink.classList.add('text-muted');
                titleLink.classList.remove('text-dark');

                const priorityBadge = card.querySelector('.badge-priority');
                if (priorityBadge) {
                    priorityBadge.className = 'badge bg-success badge-priority';
                    priorityBadge.innerText = 'Completed';
                }

                // Remove in-progress bar if present
                const progressBox = card.querySelector('.task-progress-box');
                if (progressBox) progressBox.remove();

                // Update action row
                if (actionRow) {
                    actionRow.innerHTML = `
                        <span class="small text-success"><i class="bi bi-check-all me-1"></i> 100% Done</span>
                        <a href="/Tasks/Details/${taskId}" class="btn btn-sm btn-outline-secondary py-0 px-2">View</a>
                    `;
                }
            } else if (status === 'In Progress') {
                card.classList.add('border-start', 'border-3', 'border-primary');
                titleContainer.classList.remove('text-decoration-line-through', 'text-muted');
                titleLink.classList.remove('text-muted');
                titleLink.classList.add('text-dark');

                const priorityBadge = card.querySelector('.badge-priority');
                if (priorityBadge) {
                    priorityBadge.className = `badge badge-priority ${priority === 'Critical' ? 'bg-danger' : priority === 'High' ? 'bg-warning text-dark' : 'bg-info text-dark'}`;
                    priorityBadge.innerText = priority;
                }

                // Add or update progress bar
                let progressBox = card.querySelector('.task-progress-box');
                const prog = data && data.progress !== undefined ? data.progress : 25;
                if (!progressBox) {
                    progressBox = document.createElement('div');
                    progressBox.className = 'task-progress-box mb-2';
                    progressBox.innerHTML = `
                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 0.72rem;">
                            <span>Progress</span>
                            <strong class="progress-percent-label">${prog}%</strong>
                        </div>
                        <div class="progress progress-thin">
                            <div class="progress-bar bg-primary" style="width: ${prog}%"></div>
                        </div>
                    `;
                    card.querySelector('.card-body').insertBefore(progressBox, actionRow);
                } else {
                    progressBox.querySelector('.progress-percent-label').innerText = `${prog}%`;
                    progressBox.querySelector('.progress-bar').style.width = `${prog}%`;
                }

                // Update action row
                if (actionRow) {
                    actionRow.innerHTML = `
                        <span class="small text-muted task-hours-label">${hours} / ${estHours} hrs</span>
                        <button type="button" class="btn btn-sm btn-primary py-0 px-2"
                                onclick="openQuickUpdateModal(${taskId}, '${title.replace(/'/g, "\\'")}', 'In Progress', ${prog}, ${hours})">
                            <i class="bi bi-pencil-square me-1"></i> Update
                        </button>
                    `;
                }
            } else { // Pending
                titleContainer.classList.remove('text-decoration-line-through', 'text-muted');
                titleLink.classList.remove('text-muted');
                titleLink.classList.add('text-dark');

                const priorityBadge = card.querySelector('.badge-priority');
                if (priorityBadge) {
                    priorityBadge.className = `badge badge-priority ${priority === 'Critical' ? 'bg-danger' : priority === 'High' ? 'bg-warning text-dark' : 'bg-info text-dark'}`;
                    priorityBadge.innerText = priority;
                }

                // Remove progress bar
                const progressBox = card.querySelector('.task-progress-box');
                if (progressBox) progressBox.remove();

                // Update action row
                if (actionRow) {
                    actionRow.innerHTML = `
                        <span class="small text-muted task-hours-label">${estHours} hrs est.</span>
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                onclick="openQuickUpdateModal(${taskId}, '${title.replace(/'/g, "\\'")}', 'Pending', 0, ${hours})">
                            <i class="bi bi-play-fill me-1"></i> Start Task
                        </button>
                    `;
                }
            }
        }

        function updateColumnCounters() {
            const columns = ['Pending', 'In-Progress', 'Completed'];
            columns.forEach(col => {
                const container = document.getElementById('column-' + col);
                if (!container) return;

                const cards = container.querySelectorAll('.task-card');
                const badge = document.getElementById('badge-' + col);
                if (badge) {
                    badge.innerText = cards.length;
                }

                const emptyState = container.querySelector('.empty-state');
                if (emptyState) {
                    if (cards.length === 0) {
                        emptyState.classList.remove('d-none');
                    } else {
                        emptyState.classList.add('d-none');
                    }
                }
            });
        }

        function showToast(msg, isSuccess) {
            const toastEl = document.getElementById('dragToast');
            const icon = document.getElementById('dragToastIcon');
            const msgEl = document.getElementById('dragToastMsg');

            if (isSuccess) {
                toastEl.className = 'toast align-items-center border-0 shadow-lg text-white bg-success';
                icon.className = 'bi bi-check-circle-fill text-white fs-5';
            } else {
                toastEl.className = 'toast align-items-center border-0 shadow-lg text-white bg-danger';
                icon.className = 'bi bi-exclamation-triangle-fill text-white fs-5';
            }

            msgEl.innerText = msg;
            const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
            toast.show();
        }

        function openQuickUpdateModal(taskId, title, status, progress, actualHours) {
            document.getElementById('modalTaskId').value = taskId;
            document.getElementById('modalTaskTitle').value = title;
            document.getElementById('modalStatus').value = status;
            document.getElementById('modalProgress').value = progress;
            document.getElementById('modalActualHours').value = actualHours;
            new bootstrap.Modal(document.getElementById('quickUpdateModal')).show();
        }

        function onStatusChange(newStatus) {
            if (newStatus === 'Completed') {
                document.getElementById('modalProgress').value = 100;
            }
        }
    </script>
}
