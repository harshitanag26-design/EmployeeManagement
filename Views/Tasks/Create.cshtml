@model EmployeeManagement.ViewModels.TaskFormViewModel
@{
    ViewData["Title"] = "Create Task";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">Create New Task</h3>
                <p class="text-muted small">Delegate work, set deadlines, and specify expected hours</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Tasks
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ProjectId" class="form-label small fw-semibold">Associated Project</label>
                            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select" required>
                                <option value="">-- Select Project --</option>
                            </select>
                            <span asp-validation-for="ProjectId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold">Assign Employee</label>
                            <select asp-for="AssignedTo" asp-items="Model.Employees" class="form-select" required>
                                <option value="">-- Select Employee --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TaskTitle" class="form-label small fw-semibold">Task Title</label>
                        <input asp-for="TaskTitle" class="form-control" placeholder="e.g. Implement Role-Based Access Control" required />
                        <span asp-validation-for="TaskTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold">Description & Acceptance Criteria</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide step-by-step requirements..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label small fw-semibold">Priority Level</label>
                            <select asp-for="Priority" class="form-select" required>
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-semibold">Initial Status</label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="Pending" selected>Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="On Hold">On Hold</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EstimatedHours" class="form-label small fw-semibold">Estimated Hours</label>
                            <input asp-for="EstimatedHours" class="form-control" type="number" step="0.5" min="0" required />
                            <span asp-validation-for="EstimatedHours" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label small fw-semibold">Start Date</label>
                            <input asp-for="StartDate" class="form-control" type="date" required />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label small fw-semibold">Due Date (Deadline)</label>
                            <input asp-for="DueDate" class="form-control" type="date" required />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-light btn-sm px-3">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <i class="bi bi-check-lg me-1"></i> Create Task
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
