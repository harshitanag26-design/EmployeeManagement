@model EmployeeManagement.ViewModels.TaskDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Task.TaskTitle} - Task Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.Task.TaskTitle</h2>
            <span class="badge @(Model.Task.Priority == "Critical" ? "bg-danger" : Model.Task.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")">
                @Model.Task.Priority Priority
            </span>
            <span class="badge @(Model.Task.Status == "Completed" ? "bg-success" : Model.Task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">
                @Model.Task.Status
            </span>
            @if (Model.Task.IsOverdue)
            {
                <span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Overdue</span>
            }
        </div>
        <p class="text-muted mb-0">
            Project: <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Task.ProjectId" class="text-decoration-none fw-semibold">@Model.Task.Project?.ProjectName</a>
            &bull; Assigned to: <strong>@Model.Task.Assignee?.Name</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Task.TaskId" class="btn btn-outline-primary btn-sm px-3">
                <i class="bi bi-pencil me-1"></i> Edit Task
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Tasks
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Details & Progress -->
    <div class="col-lg-7">
        <!-- Progress Bar Card -->
        <div class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">Current Completion Progress</span>
                    <h4 class="fw-bold text-primary mb-0">@Model.Task.ProgressPercentage%</h4>
                </div>
                <div class="progress mb-3" style="height: 14px; border-radius: 7px;">
                    <div class="progress-bar @(Model.Task.Status == "Completed" ? "bg-success" : Model.Task.IsOverdue ? "bg-danger" : "bg-primary") progress-bar-striped" style="width: @Model.Task.ProgressPercentage%"></div>
                </div>

                @if (Model.CanUpdateProgress)
                {
                    <div class="p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold mb-2 small text-uppercase text-secondary">
                            <i class="bi bi-sliders me-1"></i> Fast Progress & Hours Updater
                        </h6>
                        <form asp-action="UpdateProgress" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TaskId" value="@Model.Task.TaskId" />

                            <div class="row g-2 mb-2">
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-1">Status</label>
                                    <select name="Status" class="form-select form-select-sm" onchange="if(this.value==='Completed'){ document.getElementById('progInput').value=100; }">
                                        <option value="Pending" selected="@(Model.Task.Status == "Pending")">Pending</option>
                                        <option value="In Progress" selected="@(Model.Task.Status == "In Progress")">In Progress</option>
                                        <option value="Completed" selected="@(Model.Task.Status == "Completed")">Completed</option>
                                        <option value="On Hold" selected="@(Model.Task.Status == "On Hold")">On Hold</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-1">Progress (%)</label>
                                    <input type="number" id="progInput" name="ProgressPercentage" value="@Model.Task.ProgressPercentage" min="0" max="100" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-1">Actual Hours</label>
                                    <input type="number" step="0.5" name="ActualHours" value="@Model.Task.ActualHours" min="0" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="mb-2">
                                <textarea name="Comment" class="form-control form-control-sm" rows="1" placeholder="Optional progress comment..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-arrow-repeat me-1"></i> Update Status & Progress
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Task Description & Specs -->
        <div class="card mb-4">
            <div class="card-header">
                <span><i class="bi bi-card-text me-1 text-primary"></i> Requirements & Scope</span>
            </div>
            <div class="card-body">
                <p class="mb-4" style="white-space: pre-line;">@(Model.Task.Description ?? "No description provided.")</p>

                <div class="row g-3 small">
                    <div class="col-sm-6">
                        <div class="p-2 border rounded bg-light">
                            <span class="text-muted d-block" style="font-size: 0.7rem;">TIMELINE</span>
                            <strong>@Model.Task.StartDate.ToString("MMM dd, yyyy")</strong> &rarr;
                            <strong class="@(Model.Task.IsOverdue ? "text-danger" : "")">@Model.Task.DueDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-2 border rounded bg-light">
                            <span class="text-muted d-block" style="font-size: 0.7rem;">EFFORT TRACKING</span>
                            Estimated: <strong>@Model.Task.EstimatedHours hrs</strong> &bull;
                            Actual: <strong>@Model.Task.ActualHours hrs</strong>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-2 border rounded bg-light">
                            <span class="text-muted d-block" style="font-size: 0.7rem;">CREATED BY</span>
                            @(Model.Task.Creator?.Name ?? "Admin") on @Model.Task.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-2 border rounded bg-light">
                            <span class="text-muted d-block" style="font-size: 0.7rem;">COMPLETED DATE</span>
                            @(Model.Task.CompletedDate.HasValue ? Model.Task.CompletedDate.Value.ToString("MMM dd, yyyy") : "Not yet completed")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Audit Log (Section 6.9) -->
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-clock-history me-1 text-secondary"></i> Activity Audit History</span>
            </div>
            <div class="card-body p-3">
                @if (Model.Task.ActivityLogs.Any())
                {
                    <div class="timeline ps-2">
                        @foreach (var act in Model.Task.ActivityLogs)
                        {
                            <div class="border-start border-2 border-primary ps-3 pb-3 position-relative">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-dark">@act.Action</strong>
                                    <span class="text-muted" style="font-size: 0.72rem;">@act.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <div class="small text-secondary">
                                    by <strong>@act.User?.Name</strong>
                                    @if (!string.IsNullOrEmpty(act.OldValue) && !string.IsNullOrEmpty(act.NewValue))
                                    {
                                        <span>: <code class="text-danger">@act.OldValue</code> &rarr; <code class="text-success">@act.NewValue</code></span>
                                    }
                                    else if (!string.IsNullOrEmpty(act.NewValue))
                                    {
                                        <span>: @act.NewValue</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3 small">No recorded activity yet.</div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Comments & Team Discussion (Section 16) -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-chat-dots me-1 text-primary"></i> Team Discussion</span>
                <span class="badge bg-light text-dark border">@Model.Task.Comments.Count Comments</span>
            </div>
            <div class="card-body d-flex flex-column p-3">
                <!-- Add Comment Form -->
                <form asp-action="AddComment" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Task.TaskId" />
                    <div class="mb-2">
                        <textarea name="commentText" class="form-control" rows="2" placeholder="Write a comment, report a blocker, or post an update..." required></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-send me-1"></i> Post Comment
                        </button>
                    </div>
                </form>

                <hr class="my-2" />

                <!-- Comments Stream -->
                <div class="flex-grow-1 overflow-auto mt-2" style="max-height: 520px;">
                    @if (Model.Task.Comments.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var comment in Model.Task.Comments)
                            {
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                                @comment.User?.Name.Substring(0, 1).ToUpper()
                                            </div>
                                            <strong class="small text-dark">@comment.User?.Name</strong>
                                        </div>
                                        <span class="text-muted" style="font-size: 0.72rem;">@comment.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                                    </div>
                                    <p class="mb-0 small text-secondary" style="white-space: pre-line;">@comment.CommentText</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-chat-square-dots fs-2 text-muted d-block mb-2"></i>
                            No comments yet. Start the conversation!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
