@model IEnumerable<EmployeeManagement.Models.Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Department Management</h2>
        <p class="text-muted mb-0">Organize teams, organizational units, and employee allocation</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Department
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>ID</th>
                        <th>Department Name</th>
                        <th>Description</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="text-muted small">#@dept.DepartmentId</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@dept.DepartmentId" class="fw-semibold text-decoration-none text-dark">
                                    @dept.DepartmentName
                                </a>
                            </td>
                            <td class="text-muted small">@(dept.Description ?? "—")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people me-1"></i> @dept.Users.Count Employees
                                </span>
                            </td>
                            <td>
                                @if (dept.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle me-1"></i> Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@dept.DepartmentId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@dept.DepartmentId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@dept.DepartmentId" method="post" class="d-inline" onsubmit="return confirm('Toggle department status?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(dept.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(dept.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(dept.IsActive ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
