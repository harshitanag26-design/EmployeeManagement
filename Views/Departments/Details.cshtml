@model EmployeeManagement.ViewModels.DepartmentViewModel
@{
    ViewData["Title"] = $"{Model.DepartmentName} - Department Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@Model.DepartmentName</h2>
        <p class="text-muted mb-0">@(Model.Description ?? "No description available")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-outline-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card border-start border-4 border-primary">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Department Size</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h3 class="fw-bold mb-0">@Model.EmployeeCount</h3>
                    <i class="bi bi-people text-primary fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card border-start border-4 border-success">
            <div class="card-body">
                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Operational Status</span>
                <div class="d-flex justify-content-between align-items-baseline mt-2">
                    <h4 class="fw-bold mb-0 @(Model.IsActive ? "text-success" : "text-danger")">
                        @(Model.IsActive ? "Active Department" : "Inactive")
                    </h4>
                    <i class="bi @(Model.IsActive ? "bi-check-circle text-success" : "bi-x-circle text-danger") fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span><i class="bi bi-person-lines-fill me-1 text-primary"></i> Employees Assigned to this Department</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Employees.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td class="fw-semibold">@emp.Name</td>
                                <td class="text-muted small">@emp.Email</td>
                                <td>
                                    <span class="badge @(emp.RoleId == 1 ? "bg-danger" : emp.RoleId == 2 ? "bg-primary" : "bg-info text-dark")">
                                        @emp.Role?.RoleName
                                    </span>
                                </td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.UserId" class="btn btn-outline-secondary btn-sm py-0 px-2">
                                        <i class="bi bi-eye"></i> View Profile
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">No employees currently assigned to this department.</div>
        }
    </div>
</div>
