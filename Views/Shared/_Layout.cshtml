@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Productivity Hub</title>
    <!-- Early theme init to prevent screen flicker -->
    <script>
        (function () {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const queryTheme = urlParams.get('theme');
                if (queryTheme === 'dark' || queryTheme === 'light') {
                    localStorage.setItem('app-theme', queryTheme);
                }
                const storedTheme = queryTheme || localStorage.getItem('app-theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', storedTheme);
                if (storedTheme === 'dark') {
                    document.documentElement.classList.add('dark-theme');
                } else {
                    document.documentElement.classList.remove('dark-theme');
                }
            } catch (e) {}
        })();
    </script>
    <!-- Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-kanban-fill fs-4 text-primary"></i>
                    <span>TaskPro<span class="text-secondary fw-normal fs-6"> Manager</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Employees" asp-action="Index"><i class="bi bi-people me-1"></i> Employees</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3 me-1"></i> Departments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="Index"><i class="bi bi-folder2-open me-1"></i> Projects</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tasks" asp-action="Index"><i class="bi bi-check2-square me-1"></i> All Tasks</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line me-1"></i> Reports</a>
                                </li>
                            }
                            else if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Manager"><i class="bi bi-speedometer2 me-1"></i> Manager Hub</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="Index"><i class="bi bi-folder2-open me-1"></i> Projects</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tasks" asp-action="Index"><i class="bi bi-check2-square me-1"></i> Team Tasks</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line me-1"></i> Productivity Reports</a>
                                </li>
                            }
                            else // Employee
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Employee"><i class="bi bi-speedometer2 me-1"></i> My Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tasks" asp-action="MyTasks"><i class="bi bi-list-task me-1"></i> My Tasks</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tasks" asp-action="Index"><i class="bi bi-search me-1"></i> Explore Tasks</a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 gap-md-3">
                        <!-- Theme Toggle Button (Light/Dark Mode for all panels) -->
                        <button id="themeToggleBtn"
                                class="btn btn-light position-relative rounded-circle p-2 border theme-switcher-btn shadow-sm"
                                type="button"
                                onclick="toggleAppTheme()"
                                title="Switch between Light and Dark Mode"
                                aria-label="Toggle theme">
                            <i id="themeIcon" class="bi bi-moon-stars text-secondary fs-5"></i>
                        </button>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Notification Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-light position-relative rounded-circle p-2 border" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" onclick="fetchNotifications()">
                                    <i class="bi bi-bell text-secondary fs-5"></i>
                                    <span id="unreadBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end notification-dropdown p-0 shadow-sm" aria-labelledby="notificationDropdown">
                                    <div class="p-2 border-bottom d-flex justify-content-between align-items-center bg-light">
                                        <span class="fw-semibold small">Notifications</span>
                                        <button class="btn btn-link btn-sm text-decoration-none p-0" onclick="markAllNotificationsAsRead()">Mark all as read</button>
                                    </div>
                                    <div id="notificationList">
                                        <div class="text-center text-muted py-3 small">Loading notifications...</div>
                                    </div>
                                </div>
                            </div>

                            <!-- User Profile Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-outline-light text-dark dropdown-toggle d-flex align-items-center gap-2 border px-3 py-1 rounded-pill bg-white shadow-sm user-profile-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="fw-medium small">@User.Identity.Name</span>
                                    <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : User.IsInRole("Manager") ? "bg-primary" : "bg-success") badge-role">
                                        @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "Employee")
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-semibold">@User.Identity.Name</div>
                                        <div class="small text-muted">@User.FindFirstValue(ClaimTypes.Email)</div>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3 rounded-pill">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-3">
        <!-- Toast / Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-center text-muted small bg-white mt-auto">
        <div class="container-fluid">
            &copy; @DateTime.Now.Year - <strong>Employee Task & Productivity Management System</strong> &bull; BTech Minor Project
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Notification AJAX
        async function fetchNotifications() {
            try {
                const response = await fetch('/Notifications/GetNotifications');
                if (response.ok) {
                    const data = await response.json();
                    updateBadge(data.unreadCount);
                    renderNotifications(data.notifications);
                }
            } catch (err) {
                console.error("Failed to load notifications", err);
            }
        }

        function updateBadge(count) {
            const badge = document.getElementById('unreadBadge');
            if (badge) {
                if (count > 0) {
                    badge.innerText = count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }
        }

        function renderNotifications(items) {
            const list = document.getElementById('notificationList');
            if (!list) return;

            if (!items || items.length === 0) {
                list.innerHTML = '<div class="text-center text-muted py-3 small">No notifications</div>';
                return;
            }

            let html = '';
            items.forEach(n => {
                html += `
                    <div class="notification-item ${n.isRead ? '' : 'notification-unread'}" onclick="markNotificationRead(${n.notificationId})">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <strong class="small text-dark">${n.title}</strong>
                            <span class="text-muted" style="font-size: 0.7rem;">${n.createdAt}</span>
                        </div>
                        <p class="mb-0 text-secondary" style="font-size: 0.8rem;">${n.message}</p>
                    </div>
                `;
            });
            list.innerHTML = html;
        }

        async function markNotificationRead(id) {
            await fetch(`/Notifications/MarkAsRead?id=${id}`, { method: 'POST' });
            fetchNotifications();
        }

        async function markAllNotificationsAsRead() {
            await fetch('/Notifications/MarkAllAsRead', { method: 'POST' });
            fetchNotifications();
        }

        // Periodically poll notifications count
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <text>
            document.addEventListener('DOMContentLoaded', () => {
                fetchNotifications();
                setInterval(fetchNotifications, 30000);
            });
            </text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
